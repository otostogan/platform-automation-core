{
  "uid": "platform-application",
  "title": "Application",
  "tags": [
    "platform"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "project",
        "label": "Project",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "platform-prometheus"
        },
        "query": {
          "query": "label_values(platform_release_info, project)",
          "refId": "v"
        },
        "definition": "label_values(platform_release_info, project)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {}
      },
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "platform-prometheus"
        },
        "query": {
          "query": "label_values(platform_release_info{project=\"$project\"}, environment)",
          "refId": "v"
        },
        "definition": "label_values(platform_release_info{project=\"$project\"}, environment)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {}
      },
      {
        "name": "domain",
        "label": "Domain",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "platform-prometheus"
        },
        "query": {
          "query": "label_values(platform_domain_info{project=\"$project\",environment=\"$environment\"}, domain)",
          "refId": "v"
        },
        "definition": "label_values(platform_domain_info{project=\"$project\",environment=\"$environment\"}, domain)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {}
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "platform-prometheus"
        },
        "query": {
          "query": "label_values(platform_container_up{project=\"$project\",environment=\"$environment\"}, service)",
          "refId": "v"
        },
        "definition": "label_values(platform_container_up{project=\"$project\",environment=\"$environment\"}, service)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {}
      },
      {
        "name": "search",
        "label": "Search logs",
        "type": "textbox",
        "query": "",
        "current": {
          "value": ""
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Deployments",
        "datasource": {
          "type": "prometheus",
          "uid": "platform-prometheus"
        },
        "enable": true,
        "iconColor": "blue",
        "expr": "changes(platform_release_deployed_timestamp_seconds{project=\"$project\",environment=\"$environment\"}[2m]) > 0",
        "titleFormat": "deployment",
        "step": "60s"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requests / s",
      "datasource": {
        "type": "loki",
        "uid": "platform-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "platform-loki"
          },
          "expr": "sum(rate({container=\"platform-nginx\"} | json | __error__=\"\" | vhost=~`${domain:regex}` [5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "5xx share",
      "datasource": {
        "type": "loki",
        "uid": "platform-loki"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "platform-loki"
          },
          "expr": "sum(rate({container=\"platform-nginx\"} | json | __error__=\"\" | vhost=~`${domain:regex}` | status=~\"5..\" [5m])) / sum(rate({container=\"platform-nginx\"} | json | __error__=\"\" | vhost=~`${domain:regex}` [5m])) * 100 or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 3,
