      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "platform-loki"
          },
          "expr": "quantile_over_time(0.95, {container=\"platform-nginx\"} | json | __error__=\"\" | vhost=~`${domain:regex}` | unwrap request_time [5m]) by ()"
