[Unit]
Description=Scheduled platform database backup for %i
Documentation=file://{{ platform_cli_executable }}
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
# No shell: systemd expands ${...} itself before a shell would ever see it,
# so the instance is split by the CLI, where that parsing is tested.
ExecStart={{ platform_cli_executable }} backup --instance %i --reason schedule --json
TimeoutStartSec={{ platform_cli_backup_timeout }}

NoNewPrivileges=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/var/backups/platform /run/platform
RestrictRealtime=yes
RestrictSUIDSGID=yes
