[Unit]
Description=Scheduled platform export for %i
Documentation=file://{{ platform_cli_executable }}

[Timer]
# A placeholder: each deploy writes a drop-in carrying the calendar the
# application actually declared for this job.
OnCalendar=daily
Persistent=true
AccuracySec=1min
Unit=platform-export@%i.service

[Install]
WantedBy=timers.target
