[Unit]
Description=Restore platform runtime secrets before Docker starts
Documentation=file:///opt/platform/runtime/platform_automation/reboot_recovery_entrypoint.py
After=local-fs.target systemd-tmpfiles-setup.service
Before=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
Environment=PYTHONPATH=/opt/platform/runtime
Environment=PLATFORM_MINIMUM_AGE_RECIPIENTS={{ reboot_recovery_minimum_age_recipients }}
ExecStart=/usr/bin/python3 {{ reboot_recovery_entrypoint }}
TimeoutStartSec={{ reboot_recovery_timeout }}
RemainAfterExit=yes

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/run/platform/secrets /run/platform/locks
RestrictRealtime=yes
RestrictSUIDSGID=yes
